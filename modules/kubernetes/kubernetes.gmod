module "kubernetes" {
  metadata {
    description            = "Cross-cloud managed Kubernetes cluster provisioning EKS (AWS), AKS (Azure), and GKE (GCP)."
    version                = "1.0.0"
    security_tier          = "high"
    cost_tier              = "premium"
    data_classification    = "internal"
    disaster_recovery_tier = "tier1"
    approval_required      = false
  }

  interface {
    inputs {
      name = {
        required  = true
        sensitive = false
      }
      region = {
        required  = true
        sensitive = false
      }
      vpc_id = {
        required  = true
        sensitive = false
      }
      subnet_ids = {
        required  = true
        sensitive = false
      }
      instance_class = {
        required  = false
        sensitive = false
        default   = ""
      }
      resource_group_name = {
        required  = false
        sensitive = false
        default   = ""
      }
    }
    outputs {
      cluster_endpoint   = {}
      kubeconfig_command = {}
    }
  }

  validation {
    rule "name_required" {
      condition     = "$name != \"\""
      error_message = "name must not be empty"
      severity      = "error"
    }
  }

  generate {
    case "provider" {
      aws {
        code = <<-EOT
          Resources:
            EksClusterRole:
              Type: AWS::IAM::Role
              Properties:
                RoleName: $name-role
                AssumeRolePolicyDocument:
                  Version: '2012-10-17'
                  Statement:
                    - Effect: Allow
                      Principal:
                        Service: eks.amazonaws.com
                      Action: sts:AssumeRole
                ManagedPolicyArns:
                  - arn:aws:iam::aws:policy/AmazonEKSClusterPolicy

            EksCluster:
              Type: AWS::EKS::Cluster
              Properties:
                Name: $name
                RoleArn: !GetAtt EksClusterRole.Arn
                ResourcesVpcConfig:
                  SubnetIds:
                    - $subnet_ids
                    # Production: provide multiple subnet IDs for multi-AZ deployment
        EOT
        outputs {
          cluster_endpoint   = "!GetAtt EksCluster.Endpoint"
          kubeconfig_command = "aws eks update-kubeconfig --region $region --name $name"
        }
      }
      azure {
        code = <<-EOT
          resource aksCluster 'Microsoft.ContainerService/managedClusters@2024-02-01' = {
            name: '$name'
            location: '$region'
            identity: {
              type: 'SystemAssigned'
            }
            properties: {
              dnsPrefix: '$name'
              agentPoolProfiles: [
                {
                  name: 'default'
                  count: 1
                  vmSize: '$instance_class'
                  mode: 'System'
                }
              ]
            }
          }
        EOT
        outputs {
          cluster_endpoint   = "aksCluster.properties.fqdn"
          kubeconfig_command = "az aks get-credentials --resource-group $resource_group_name --name $name"
        }
      }
      gcp {
        code = <<-EOT
          resource "google_container_cluster" "$name" {
            name     = "$name"
            location = "$region"
            network  = "$vpc_id"

            initial_node_count = 1

            node_config {
              machine_type = "$instance_class"
            }
          }
        EOT
        outputs {
          cluster_endpoint   = "${google_container_cluster.kubernetes.endpoint}"
          kubeconfig_command = "gcloud container clusters get-credentials $name --region $region"
        }
      }
    }
  }
}
