module "relational_db" {
  metadata {
    description            = "Cross-cloud managed relational database provisioning Aurora PostgreSQL, Azure DB for PostgreSQL, and Cloud SQL."
    version                = "1.0.0"
    security_tier          = "medium"
    compliance_frameworks  = "SOC2,HIPAA"
    cost_tier              = "premium"
    data_classification    = "confidential"
    disaster_recovery_tier = "tier1"
    approval_required      = false
  }

  interface {
    inputs {
      name = {
        required  = true
        sensitive = false
      }
      region = {
        required  = true
        sensitive = false
      }
      db_username = {
        required  = true
        sensitive = false
      }
      db_password = {
        required  = true
        sensitive = true
      }
      instance_class = {
        required  = false
        sensitive = false
        default   = ""
      }
      vpc_id = {
        required  = true
        sensitive = false
      }
      subnet_ids = {
        required  = true
        sensitive = false
      }
    }
    outputs {
      endpoint = {}
      port     = {}
    }
  }

  validation {
    rule "db_password_required" {
      condition     = "$db_password != \"\""
      error_message = "db_password must not be empty"
      severity      = "error"
    }
  }

  generate {
    case "provider" {
      aws {
        code = <<-EOT
          Resources:
            RelationalDbSubnetGroup:
              Type: AWS::RDS::DBSubnetGroup
              Properties:
                DBSubnetGroupDescription: $name subnet group
                SubnetIds:
                  - $subnet_ids
                  # Production: provide multiple subnet IDs for multi-AZ deployment

            RelationalDbCluster:
              Type: AWS::RDS::DBCluster
              Properties:
                Engine: aurora-postgresql
                MasterUsername: $db_username
                MasterUserPassword: $db_password
                DBSubnetGroupName: !Ref RelationalDbSubnetGroup
        EOT
        outputs {
          endpoint = "!GetAtt RelationalDbCluster.Endpoint.Address"
          port     = "!GetAtt RelationalDbCluster.Endpoint.Port"
        }
      }
      azure {
        code = <<-EOT
          resource relationalDbServer 'Microsoft.DBforPostgreSQL/flexibleServers@2023-06-01-preview' = {
            name: '$name'
            location: '$region'
            sku: {
              name: '$instance_class'
              tier: 'GeneralPurpose'
            }
            properties: {
              administratorLogin: '$db_username'
              administratorLoginPassword: '$db_password'
              storage: {
                storageSizeGB: 32
              }
              version: '15'
              network: {
                delegatedSubnetResourceId: '$subnet_ids'
                # Production: wire private_dns_zone_id from a Microsoft.Network/privateDnsZones resource
              }
            }
          }
        EOT
        outputs {
          endpoint = "relationalDbServer.properties.fullyQualifiedDomainName"
          port     = "5432"
        }
      }
      gcp {
        code = <<-EOT
          resource "google_sql_database_instance" "$name" {
            name             = "$name"
            region           = "$region"
            database_version = "POSTGRES_15"
            settings {
              tier = "$instance_class"
              ip_configuration {
                private_network = "$vpc_id"
                ipv4_enabled    = false
              }
            }
            root_password = "$db_password"
          }
          resource "google_sql_user" "db_admin" {
            instance = "$name"
            name     = "$db_username"
          }
        EOT
        outputs {
          endpoint = "${google_sql_database_instance.relational_db.connection_name}"
          port     = "5432"
        }
      }
    }
  }
}
