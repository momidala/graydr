module "dns" {
  metadata {
    description            = "Cross-cloud managed DNS hosted zone provisioning Route 53 (AWS), Azure DNS (Azure), and Cloud DNS (GCP)."
    version                = "1.0.0"
    security_tier          = "low"
    cost_tier              = "low"
    data_classification    = "public"
    disaster_recovery_tier = "tier2"
    approval_required      = false
  }

  interface {
    inputs {
      name = {
        required  = true
        sensitive = false
      }
      region = {
        required  = false
        sensitive = false
        default   = ""
      }
      resource_group_name = {
        required  = false
        sensitive = false
        default   = ""
      }
    }
    outputs {
      zone_id     = {}
      nameservers = {}
    }
  }

  validation {
    rule "name_required" {
      condition     = "$name != \"\""
      error_message = "name must not be empty"
      severity      = "error"
    }
  }

  generate {
    case "provider" {
      aws {
        code = <<-EOT
          Resources:
            DnsHostedZone:
              Type: AWS::Route53::HostedZone
              Properties:
                Name: $name
        EOT
        outputs {
          zone_id     = "!Ref DnsHostedZone"
          nameservers = "!Select [0, !GetAtt DnsHostedZone.NameServers]"
        }
        # nameservers exposes the first NS record; production templates should access the full NameServers list from the resource directly
      }
      azure {
        code = <<-EOT
          resource dnsZone 'Microsoft.Network/dnsZones@2018-05-01' = {
            name: '$name'
            location: 'global'
          }
        EOT
        outputs {
          zone_id     = "dnsZone.id"
          nameservers = "dnsZone.properties.nameServers[0]"
        }
      }
      gcp {
        code = <<-EOT
          resource "google_dns_managed_zone" "$name" {
            name     = "$name"
            dns_name = "$name."
            # dns_name requires a trailing dot per GCP Cloud DNS requirements
          }
        EOT
        outputs {
          zone_id     = "${google_dns_managed_zone.dns.id}"
          nameservers = "${google_dns_managed_zone.dns.name_servers.0}"
        }
      }
    }
  }
}
