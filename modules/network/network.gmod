module "network" {
  metadata {
    description            = "Cross-cloud network layer providing VPC, subnet, and private endpoint infrastructure."
    version                = "1.0.0"
    security_tier          = "high"
    cost_tier              = "standard"
    data_classification    = "internal"
    disaster_recovery_tier = "tier1"
    approval_required      = false
  }

  interface {
    inputs {
      name       = { required = true,  sensitive = false }
      region     = { required = true,  sensitive = false }
      cidr_block = { required = true,  sensitive = false }
    }
    outputs {
      vpc_id            = {}
      subnet_ids        = {}
      private_endpoints = {}
    }
  }

  validation {
    rule "name_required" {
      condition     = "$name != \"\""
      error_message = "name must not be empty"
      severity      = "error"
    }
  }

  generate {
    case "provider" {
      aws {
        code = <<-EOT
          Resources:
            NetworkVpc:
              Type: AWS::EC2::VPC
              Properties:
                CidrBlock: $cidr_block
                Tags:
                  - Key: Name
                    Value: $name

            # Single-subnet minimal implementation.
            # Production deployments should expand to one subnet per availability zone.
            NetworkSubnet:
              Type: AWS::EC2::Subnet
              Properties:
                VpcId: !Ref NetworkVpc
                CidrBlock: $cidr_block
                AvailabilityZone: $region
                Tags:
                  - Key: Name
                    Value: $name
        EOT
        outputs {
          vpc_id            = "!Ref NetworkVpc"
          subnet_ids        = "!Ref NetworkSubnet"
          # private endpoints are wired by the consuming template as separate resources
          private_endpoints = ""
        }
      }

      azure {
        code = <<-EOT
          resource vnet 'Microsoft.Network/virtualNetworks@2024-05-01' = {
            name: '$name'
            location: '$region'
            properties: {
              addressSpace: {
                addressPrefixes: ['$cidr_block']
              }
            }

            # Single-subnet minimal implementation.
            # Production deployments should expand to multiple subnets.
            resource subnet 'subnets' = {
              name: '$name-subnet'
              properties: {
                addressPrefix: '$cidr_block'
              }
            }
          }
        EOT
        outputs {
          vpc_id            = "vnet.id"
          subnet_ids        = "vnet::subnet.id"
          # private endpoints are wired by the consuming template as separate resources
          private_endpoints = ""
        }
      }

      gcp {
        code = <<-EOT
          resource "google_compute_network" "$name" {
            name                    = "$name"
            auto_create_subnetworks = false
          }

          # Single-subnet minimal implementation.
          # Production deployments should expand to multiple subnets across regions.
          resource "google_compute_subnetwork" "$name" {
            name          = "$name"
            region        = "$region"
            ip_cidr_range = "$cidr_block"
          }
        EOT
        outputs {
          vpc_id            = "${google_compute_network.main_network.id}"
          subnet_ids        = "${google_compute_subnetwork.main_network.id}"
          # private endpoints are wired by the consuming template as separate resources
          private_endpoints = ""
        }
      }
    }
  }
}
