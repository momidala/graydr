module "load_balancer" {
  metadata {
    description            = "Cross-cloud HTTP/HTTPS application load balancer provisioning ALB (AWS), Application Gateway (Azure), and Cloud Load Balancing (GCP)."
    version                = "1.0.0"
    security_tier          = "high"
    cost_tier              = "standard"
    data_classification    = "public"
    disaster_recovery_tier = "tier1"
    approval_required      = false
  }

  interface {
    inputs {
      name = {
        required  = true
        sensitive = false
      }
      region = {
        required  = true
        sensitive = false
      }
      resource_group_name = {
        required  = false
        sensitive = false
        default   = ""
      }
    }
    outputs {
      dns_name = {}
    }
  }

  validation {
    rule "name_required" {
      condition     = "$name != \"\""
      error_message = "name must not be empty"
      severity      = "error"
    }
  }

  generate {
    case "provider" {
      aws {
        code = <<-EOT
          Resources:
            AppLoadBalancer:
              Type: AWS::ElasticLoadBalancingV2::LoadBalancer
              Properties:
                Name: $name
                Type: application
                Scheme: internet-facing
                Subnets:
                  - ""
                  # Production: wire from network module subnet_ids output
        EOT
        outputs {
          dns_name = "!GetAtt AppLoadBalancer.DNSName"
        }
      }
      azure {
        code = <<-EOT
          resource publicIp 'Microsoft.Network/publicIPAddresses@2023-11-01' = {
            name: '$name-pip'
            location: '$region'
            sku: {
              name: 'Standard'
            }
            properties: {
              publicIPAllocationMethod: 'Static'
              dnsSettings: {
                domainNameLabel: '$name'
              }
            }
          }

          resource appGateway 'Microsoft.Network/applicationGateways@2023-11-01' = {
            name: '$name'
            location: '$region'
            properties: {
              sku: {
                name: 'Standard_v2'
                tier: 'Standard_v2'
                capacity: 1
              }
              gatewayIPConfigurations: [
                {
                  name: 'main'
                  properties: {
                    subnet: {
                      id: ''
                      // Production: wire from network module subnet output
                    }
                  }
                }
              ]
              frontendIPConfigurations: [
                {
                  name: 'main'
                  properties: {
                    publicIPAddress: {
                      id: publicIp.id
                    }
                  }
                }
              ]
              frontendPorts: [
                {
                  name: 'http'
                  properties: {
                    port: 80
                  }
                }
              ]
              backendAddressPools: [
                {
                  name: '$name-bap'
                }
              ]
              backendHttpSettingsCollection: [
                {
                  name: '$name-bhs'
                  properties: {
                    port: 80
                    protocol: 'Http'
                    cookieBasedAffinity: 'Disabled'
                    requestTimeout: 60
                  }
                }
              ]
              httpListeners: [
                {
                  name: '$name-listener'
                  properties: {
                    frontendIPConfiguration: {
                      id: resourceId('Microsoft.Network/applicationGateways/frontendIPConfigurations', '$name', 'main')
                    }
                    frontendPort: {
                      id: resourceId('Microsoft.Network/applicationGateways/frontendPorts', '$name', 'http')
                    }
                    protocol: 'Http'
                  }
                }
              ]
              requestRoutingRules: [
                {
                  name: '$name-rule'
                  properties: {
                    ruleType: 'Basic'
                    priority: 10
                    httpListener: {
                      id: resourceId('Microsoft.Network/applicationGateways/httpListeners', '$name', '$name-listener')
                    }
                    backendAddressPool: {
                      id: resourceId('Microsoft.Network/applicationGateways/backendAddressPools', '$name', '$name-bap')
                    }
                    backendHttpSettings: {
                      id: resourceId('Microsoft.Network/applicationGateways/backendHttpSettingsCollection', '$name', '$name-bhs')
                    }
                  }
                }
              ]
            }
          }
        EOT
        outputs {
          dns_name = "publicIp.properties.dnsSettings.fqdn"
        }
      }
      gcp {
        code = <<-EOT
          resource "google_compute_backend_service" "lb" {
            name                  = "$name"
            load_balancing_scheme = "EXTERNAL"
            protocol              = "HTTP"
          }

          resource "google_compute_url_map" "lb" {
            name            = "$name"
            default_service = "${google_compute_backend_service.lb.id}"
          }

          resource "google_compute_target_http_proxy" "lb" {
            name    = "$name"
            url_map = "${google_compute_url_map.lb.id}"
          }

          resource "google_compute_global_forwarding_rule" "lb" {
            name                  = "$name"
            load_balancing_scheme = "EXTERNAL"
            port_range            = "80"
            target                = "${google_compute_target_http_proxy.lb.id}"
          }
        EOT
        outputs {
          dns_name = "${google_compute_global_forwarding_rule.load_balancer.ip_address}"
        }
      }
    }
  }
}
