module "cache" {
  metadata {
    description            = "Cross-cloud managed Redis cache for application session and data caching."
    version                = "1.0.0"
    security_tier          = "medium"
    cost_tier              = "standard"
    data_classification    = "internal"
    disaster_recovery_tier = "tier2"
    approval_required      = false
  }

  interface {
    inputs {
      name = {
        required  = true
        sensitive = false
      }
      region = {
        required  = true
        sensitive = false
      }
      node_type = {
        required  = false
        sensitive = false
        default   = ""
      }
      resource_group_name = {
        required  = false
        sensitive = false
        default   = ""
      }
    }
    outputs {
      endpoint = {}
      port     = {}
    }
  }

  validation {
    rule "name_required" {
      condition     = "$name != \"\""
      error_message = "name must not be empty"
      severity      = "error"
    }
  }

  generate {
    case "provider" {
      aws {
        code = <<-EOT
          Resources:
            CacheReplicationGroup:
              Type: AWS::ElastiCache::ReplicationGroup
              Properties:
                ReplicationGroupDescription: $name
                CacheNodeType: $node_type
                NumCacheClusters: 1
        EOT
        outputs {
          endpoint = "!GetAtt CacheReplicationGroup.PrimaryEndPoint.Address"
          port     = "!GetAtt CacheReplicationGroup.PrimaryEndPoint.Port"
        }
      }
      azure {
        code = <<-EOT
          resource redisCache 'Microsoft.Cache/redis@2023-04-01' = {
            name: '$name'
            location: '$region'
            properties: {
              sku: {
                capacity: 1
                family: 'C'
                name: 'Standard'
              }
              enableNonSslPort: false
            }
          }
        EOT
        outputs {
          endpoint = "redisCache.properties.hostName"
          port     = "6380"
        }
      }
      gcp {
        code = <<-EOT
          resource "google_redis_instance" "$name" {
            name           = "$name"
            region         = "$region"
            memory_size_gb = 1
          }
        EOT
        outputs {
          endpoint = "${google_redis_instance.cache.host}"
          port     = "6379"
        }
      }
    }
  }
}
