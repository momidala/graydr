module "secret_manager" {
  metadata {
    description            = "Cross-cloud secrets management provisioning Secrets Manager (AWS), Key Vault (Azure), and Secret Manager (GCP)."
    version                = "1.0.0"
    security_tier          = "critical"
    compliance_frameworks  = "SOC2,PCI-DSS"
    cost_tier              = "standard"
    data_classification    = "restricted"
    disaster_recovery_tier = "tier1"
    approval_required      = true
  }

  interface {
    inputs {
      name = {
        required  = true
        sensitive = false
      }
      region = {
        required  = true
        sensitive = false
      }
      resource_group_name = {
        required  = false
        sensitive = false
        default   = ""
      }
      tenant_id = {
        required  = false
        sensitive = false
        default   = ""
      }
    }
    outputs {
      secret_arn = {}
      secret_id  = {}
    }
  }

  validation {
    rule "name_required" {
      condition     = "$name != \"\""
      error_message = "name must not be empty"
      severity      = "error"
    }
  }

  generate {
    case "provider" {
      aws {
        code = <<-EOT
          Resources:
            SecretManagerSecret:
              Type: AWS::SecretsManager::Secret
              Properties:
                Name: $name
                Description: Managed by graydr secret_manager module
        EOT
        outputs {
          secret_arn = "!Ref SecretManagerSecret"
        }
      }
      azure {
        code = <<-EOT
          resource secretManagerVault 'Microsoft.KeyVault/vaults@2023-07-01' = {
            name: '$name'
            location: '$region'
            properties: {
              sku: {
                family: 'A'
                name: 'standard'
              }
              tenantId: '$tenant_id'
              # Production: supply tenant_id from your Azure AD tenant via properties file
              accessPolicies: []
              enabledForDeployment: false
              enabledForDiskEncryption: false
              enabledForTemplateDeployment: false
            }
          }
        EOT
        outputs {
          secret_id = "secretManagerVault.id"
        }
      }
      gcp {
        code = <<-EOT
          resource "google_secret_manager_secret" "secret_manager" {
            secret_id = "$name"
            replication {
              auto {}
            }
            # replication block is required by GCP Secret Manager API
          }
        EOT
        outputs {
          secret_id = "${google_secret_manager_secret.secret_manager.id}"
        }
      }
    }
  }
}
