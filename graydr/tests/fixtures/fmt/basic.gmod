module "example" {
  metadata {
    name = "example"
    version    =  "1.0.0"
    description="A basic test module"
  }
  interface {
    inputs {
      size {
        type = string
        required = true
      }
      name    {
        type   = string
        required    = true
      }
    }
    outputs {
      endpoint {
        type = string
      }
    }
  }
}
