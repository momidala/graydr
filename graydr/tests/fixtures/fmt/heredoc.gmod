module "heredoc_test" {
  metadata {
    name    = "heredoc_test"
    version = "1.0.0"
  }
  interface {
    inputs {
      size { type = string, required = true }
    }
    outputs {
      endpoint { type = string }
    }
  }
  generate {
    case ($provider) {
      "aws": {
        code = <<-CFN
          AWSTemplateFormatVersion: "2010-09-09"
          Resources:
            MyBucket:
              Type: AWS::S3::Bucket
              Properties:
                BucketName: !Sub "${AWS::StackName}-bucket"
        CFN
        outputs {
          endpoint = "!GetAtt MyBucket.WebsiteURL"
        }
      }
    }
  }
}
