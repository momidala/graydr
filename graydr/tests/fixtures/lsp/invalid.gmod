module "lsp_test_invalid" {
  metadata {
    name        = "lsp_test_invalid"
    version     = "1.0.0"
    description = "LSP integration test fixture — lint warning"
    authors     = ["test"]
    tags        = ["test"]
    lifecycle {
      maturity = "stable"
    }
    governance {
      security_tier         = "low"
      compliance_frameworks = []
      data_classification   = "public"
    }
  }
  interface {
    inputs {
      provider { type = string, required = true }
      size     {}
    }
    outputs {
      value { type = string }
    }
  }
  generate {
    case ($provider) {
      "aws": {
        code = <<-BODY
          resource "null_resource" "test" { tags = { Size = "$size" } }
        BODY
        outputs {
          value = "null_resource.test.id"
        }
      }
    }
  }
}
