module "lsp_test_invalid" {
  metadata {
    name                   = "lsp_test_invalid"
    version                = "1.0.0"
    description            = "LSP integration test fixture — lint warning (size missing type)"
    security_tier          = "low"
    compliance_frameworks  = "none"
    cost_tier              = "low"
    data_classification    = "public"
    disaster_recovery_tier = "none"
  }
  interface {
    inputs {
      provider = { type = "string", required = true }
      size     = {}
    }
    outputs {
      value = {}
    }
  }
  validation {}
  generate {
    case "provider" {
      aws {
        code = <<-BODY
          resource "null_resource" "test_$provider" { tags = { Size = "$size" } }
        BODY
        outputs {
          value = "null_resource.test_$provider.id"
        }
      }
    }
  }
}
