module "clean_test" {
  metadata {
    name        = "clean_test"
    version     = "1.0.0"
    description = "A module that passes all lint checks"

    security_tier          = "medium"
    compliance_frameworks  = "soc2"
    cost_tier              = "low"
    data_classification    = "internal"
    disaster_recovery_tier = "standard"
  }

  interface {
    inputs {
      size = { type = "string", required = true }
      name = { type = "string", required = true }
    }
    outputs {
      endpoint = {}
    }
  }

  validation {}

  generate {
    case "provider" {
      aws {
        code = <<-EOT
          resource "aws_s3_bucket" "$name" {
            bucket = "$name-$size"
            region = "${var.region}"
          }
        EOT
        outputs {
          endpoint = "${aws_s3_bucket.clean_test.bucket_regional_domain_name}"
        }
      }
    }
  }
}
