module "clean_test" {
  metadata {
    name        = "clean_test"
    version     = "1.0.0"
    description = "A module that passes all lint checks"

    security_tier          = "medium"
    compliance_frameworks  = "soc2"
    cost_tier              = "low"
    data_classification    = "internal"
    disaster_recovery_tier = "standard"
  }

  interface {
    inputs {
      size = { type = "string", required = true }
      name = { type = "string", required = true }
    }
    outputs {
      endpoint = {}
    }
  }

  validation {}

  generate {
    case "provider" {
      aws {
        code = <<-CFN
          Resources:
            MyBucket:
              Type: AWS::S3::Bucket
              Properties:
                BucketName: !Sub "${AWS::StackName}-$name-$size"
        CFN
        outputs {
          endpoint = "!GetAtt MyBucket.WebsiteURL"
        }
      }
    }
  }
}
