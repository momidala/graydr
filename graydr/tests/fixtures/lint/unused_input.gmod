module "unused_input_test" {
  metadata {
    name    = "unused_input_test"
    version = "1.0.0"
  }

  interface {
    inputs {
      size   = { type = "string", required = true }
      region = { type = "string", required = true }
    }
    outputs {
      endpoint = {}
    }
  }

  validation {}

  generate {
    case "provider" {
      aws {
        code = <<-EOT
          resource "aws_s3_bucket" "my_bucket" {
            bucket = "my-bucket-$size"
            region = "${var.region}"
          }
        EOT
        outputs {
          endpoint = "${aws_s3_bucket.my_bucket.bucket_regional_domain_name}"
        }
      }
    }
  }
}
