module "unwired_output_test" {
  metadata {
    name    = "unwired_output_test"
    version = "1.0.0"
  }

  interface {
    inputs {
      size = { type = "string", required = true }
    }
    outputs {
      endpoint = {}
      port     = {}
    }
  }

  validation {}

  generate {
    case "provider" {
      aws {
        code = <<-CFN
          Resources:
            MyDB:
              Type: AWS::RDS::DBInstance
        CFN
        outputs {
          endpoint = "!GetAtt MyDB.Endpoint.Address"
        }
      }
    }
  }
}
