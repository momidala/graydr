module "empty_arm_test" {
  metadata {
    name    = "empty_arm_test"
    version = "1.0.0"
  }

  interface {
    inputs {
      size = { type = "string", required = true }
    }
    outputs {
      endpoint = {}
    }
  }

  validation {}

  generate {
    case "provider" {
      aws {
        code = <<-CFN
          Resources:
            MyBucket:
              Type: AWS::S3::Bucket
        CFN
        outputs {
          endpoint = "!GetAtt MyBucket.WebsiteURL"
        }
      }
      gcp {
        code = <<-TF

        TF
        outputs {
          endpoint = "google_storage_bucket.bucket.url"
        }
      }
    }
  }
}
