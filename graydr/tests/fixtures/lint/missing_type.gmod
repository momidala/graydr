module "missing_type_test" {
  metadata {
    name    = "missing_type_test"
    version = "1.0.0"
  }

  interface {
    inputs {
      size = { required = true }
      name = { required = true }
    }
    outputs {
      endpoint = {}
    }
  }

  validation {}

  generate {
    case "provider" {
      aws {
        code = <<-EOT
          resource "aws_s3_bucket" "$name" {
            bucket = "$name-$size"
            region = "${var.region}"
          }
        EOT
        outputs {
          endpoint = "${aws_s3_bucket.missing_type_test.bucket_regional_domain_name}"
        }
      }
    }
  }
}
